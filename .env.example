# Digestary — environment configuration
# Copy to .env and set a strong COUCHDB_PASSWORD (and SESSION_SECRET, if you
# use AUTH_MODE=public) before first run.

# ── CouchDB admin credentials (used by the app + MCP to talk to CouchDB) ──
COUCHDB_USER=admin
COUCHDB_PASSWORD=please_change_me

# ── MCP write secret ───────────────────────────────────────────────────
# Required for the MCP server to write anything at all (a finding, an item
# emoji, a prefilled catalog entry) — leave it unset and a connected model
# can only read. Also required on every request to the MCP HTTP endpoint
# (8090), reads included, once MCP_TRANSPORT=http.
MCP_SECRET=change-this-mcp-secret

# ── CORS origin for the web UI ──────────────────────────────────────────
# '*' is fine for LAN-only use. Lock it down (e.g. http://my-host.local)
# if you put a reverse proxy in front and want to restrict cross-origin.
CORS_ORIGIN=*

# ── Auth mode ───────────────────────────────────────────────────────────
# "local"  (default): no login — open on your LAN. Good for a personal
#            home device; anyone on the network can use the UI.
# "public"           : a real username/password login is required for
#            owner access (session cookie). No guest/no-account access
#            exists in either mode.
AUTH_MODE=local

# ── Owner account bootstrap (AUTH_MODE=public only) ─────────────────────
# Used ONCE, on first boot, to create the first owner account — only if the
# `users` database is still empty. After that, log in and use the UI (or
# POST /api/auth/users while logged in) to add more owner accounts; these
# two variables can be cleared from .env afterwards.
OWNER_USERNAME=
OWNER_PASSWORD=

# Signs the login session cookie. REQUIRED if AUTH_MODE=public (the app
# refuses to start without it in that mode). Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# ── Passkeys (WebAuthn) — optional per-account 2nd factor ────────────────
# Leave both blank to disable entirely (the default) — the Security
# section in the UI stays hidden and login is password-only, no errors.
# Once set, an owner can enroll a passkey from the UI; from then on their
# login requires it too. IMPORTANT: WebAuthn is a browser API that refuses
# to run outside a secure context — WEBAUTHN_ORIGIN must be an `https://`
# origin (or exactly `http://localhost:<port>` for local dev). It will NOT
# work over this app's documented default LAN-IP/HTTP deployment unless you
# put a TLS-terminating reverse proxy (Caddy/Nginx) in front — see README.
#   WEBAUTHN_RP_ID     — the bare domain, e.g. digestary.example.com
#   WEBAUTHN_RP_NAME   — display name shown in the browser's passkey prompt
#   WEBAUTHN_ORIGIN    — the full origin the browser sees, e.g.
#                        https://digestary.example.com (no trailing slash)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Digestary
WEBAUTHN_ORIGIN=

# ── Optional tunables ───────────────────────────────────────────────────
# Temperature (°C) at or above which the UI shows a "fever" color.
FEVER_THRESHOLD=37.8
# The language you log in — informational for a connected LLM only (the
# app itself is language-agnostic; every name you type is stored as-is).
# Used if you ask an agent to prefill common foods/symptoms/bathroom kinds
# or fill in food emoji (see README) — it's a manual step, never automatic.
LANGUAGE=en
# How the in-stack MCP server speaks MCP. "http" (default, so external
# agents can reach it via the exposed port) or "stdio" (to run as a
# subprocess an agent launches directly).
MCP_TRANSPORT=http

# ── Host-side port mappings (inside-container ports stay 5984/8000) ──────
# Uncomment to override the defaults (3080 / 8080 / 8090). If you run more
# than one person's stack on the same machine (see README — one stack per
# person), give each clone its own set of these.
# COUCHDB_HOST_PORT=3080
# APP_HOST_PORT=8080
# MCP_HOST_PORT=8090
